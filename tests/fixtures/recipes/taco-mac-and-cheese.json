  "steps": [
   {
    "text": "Dice yellow bell peppers, red bell peppers, and an onion. Sauté in a large nonstick pan over medium heat for ~10 minutes or until softened. Remove from pan and set aside."
   },
   {
    "text": "Bring a large pot of salted water to a boil. Add pasta and cook according to package directions. Drain and set aside."
   },
   {
    "text": "In the same pan, cook 93% ground beef over medium-high heat until nearly cooked through. Add a taco seasoning packet, a splash of water, red enchilada sauce, and optional chili and garlic powder. Stir in the cooked pepper and onion mixture."
   },
   {
    "text": "In a blender, combine 2% cottage cheese, cheddar powder, Velveeta cheddar shreds OR reduced-fat cheddar, nutritional yeast, and 1% milk. Blend for 60–90 seconds until completely smooth. Add hot sauce if desired."
   },
   {
    "text": "In a large bowl or pot, mix the cooked pasta with the taco beef mixture. Pour over the cheese sauce and stir until evenly combined."
   }
  ]
 },
